# `npm run dev`. Hai đường dẫn backend nằm trong .env — ở đây chỉ chọn dùng cái nào.
#
#   server -> https://app-qlpk-hoangqlpk97.azurewebsites.net/api  (đang dùng)
#   local  -> http://localhost:5131/api
#
# Hoặc để nguyên và chạy `npm run dev:local` khi cần test backend tại máy.
# Đây là mặt đối xứng của Cors:AllowedOrigins trong QLPK/appsettings.json ở backend.
VITE_API_TARGET=server
