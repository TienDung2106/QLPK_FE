# Nạp cho MỌI mode (dev, build, dev:local). Khai báo sẵn cả hai backend ở đây để không bao giờ
# phải sửa hay comment lại URL — chỉ việc chọn bằng VITE_API_TARGET.
#
#   npm run dev        -> .env.development  (VITE_API_TARGET=server, gọi Azure)
#   npm run dev:local  -> .env.localapi     (VITE_API_TARGET=local,  gọi localhost:5131)
#   npm run build      -> .env.production   (luôn server — đây là bản deploy)
#
# Muốn đổi ngay trong `npm run dev` thì sửa VITE_API_TARGET ở .env.development rồi chạy lại.

VITE_API_TARGET=server

# --- Backend đã deploy trên Azure ---
VITE_API_ROOT_SERVER=https://app-qlpk-hoangqlpk97.azurewebsites.net/api
# Site key THẬT; 'localhost' phải có trong danh sách hostname của widget ở Cloudflare Turnstile,
# nếu không widget báo lỗi 110200 khi chạy dev.
VITE_TURNSTILE_SITE_KEY_SERVER=0x4AAAAAAEgL308hsDpDZ-XH

# --- Backend chạy tại máy (`dotnet run --launch-profile http` trong QLPK/) ---
# Tạm tắt: mọi mode đều gọi Azure. Bỏ comment 2 dòng dưới để dùng lại.
# VITE_API_ROOT_LOCAL=http://localhost:5131/api
# Test key luôn-pass của Cloudflare, khớp test secret trong appsettings.Development.json.
# VITE_TURNSTILE_SITE_KEY_LOCAL=1x00000000000000000000AA
